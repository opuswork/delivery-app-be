// Voice Delivery App — database schema.
// Column-level format rules (4-digit login ID, yyyy-mm-dd dates) are enforced
// by CHECK constraints in the initial migration, in addition to DTO validation.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int              @id @default(autoincrement())
  /// Middle 4 digits of the phone number. CHECK: ^[0-9]{4}$
  /// Not unique: people can share it; the password (which ends in the
  /// phone's last 4 digits) tells them apart.
  loginId    String           @db.Char(4)
  /// bcrypt hash of the 8-digit numeric password (never plaintext).
  password   String
  fullName   String           @db.VarChar(50)
  churchName String           @default("joongang") @db.VarChar(100)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deliveries DeliveryRecord[]

  @@index([loginId])
  @@map("users")
}

model DeliveryRecord {
  delivery_number Int      @id @default(autoincrement())
  /// 납품일, yyyy-mm-dd. CHECK: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$
  delivery_date   String   @db.VarChar(10)
  /// 납품처, e.g. "홈플러스" (empty for rows saved before it was its own field)
  company_name    String   @db.VarChar(100)
  /// 납품종류: 런 | 두부 | 간장. No longer set by the app (badge_color replaced it).
  /// CHECK: delivery_type IN ('', '런', '두부', '간장')
  delivery_type   String   @default("") @db.VarChar(10)
  /// 납품처 badge colour, #RRGGBB, or '' for the default colour.
  /// CHECK: badge_color ~ '^(#[0-9A-F]{6})?$'
  badge_color     String   @default("") @db.VarChar(7)
  /// Free text, may be empty, e.g. "1급진간장 1.8리터 10통"
  memo            String   @db.VarChar(1000)
  userid          Int
  user            User     @relation(fields: [userid], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userid, delivery_date])
  @@map("delivery_records")
}
