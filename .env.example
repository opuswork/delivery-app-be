# Server
PORT=4100
CORS_ORIGIN=http://localhost:3100

# Database (matches the root docker-compose.yml)
DATABASE_URL=postgresql://delivery:change-me@localhost:5435/voice_delivery?schema=public

# JWT — generate a long random secret, never commit the real one
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Seed user (prisma/seed.ts)
SEED_USER_LOGIN_ID=1234
SEED_USER_PASSWORD=12345678
SEED_USER_FULL_NAME=홍길동
SEED_USER_CHURCH_NAME=joongang
